# Salin menjadi "src/.env" di VPS (BUKAN di laptop, JANGAN di-commit),
# isi nilai aslinya, lalu chmod 600 src/.env
# APP_KEY: generate SEKALI di VPS/dalam container (php artisan key:generate --show)
# lalu tempel di sini. Mengganti APP_KEY setelah ada data terenkripsi/sesi
# akan membuat data itu tidak bisa dibaca lagi.
APP_NAME="RamzApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://<domain-ramz>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# DB sentral: host SELALU nama container shared-db, database & user KHUSUS app ini.
DB_CONNECTION=mariadb
DB_HOST=shared-db
DB_PORT=3306
DB_DATABASE=ramz_app
DB_USERNAME=ramz_user
DB_PASSWORD=<password_ramz_user_dari_init_sql>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
